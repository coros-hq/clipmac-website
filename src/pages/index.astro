---
const RELEASES = 'https://github.com/coros-hq/clipmac/releases/latest';
const REPO = 'https://github.com/coros-hq/clipmac';

const keys = [
	{ k: ['↑', '↓'], d: 'Move through clips' },
	{ k: ['⏎'], d: 'Copy the selected clip' },
	{ k: ['⌘', 'F'], d: 'Search (or press /)' },
	{ k: ['Esc'], d: 'Clear search, close panels' },
	{ k: ['⌘', 'D'], d: 'Favorite or unfavorite' },
	{ k: ['⌘', 'E'], d: 'Edit the selected image' },
	{ k: ['⌘', '⌫'], d: 'Delete the selected clip' },
];

const fine = [
	{ h: 'Everything stays on your Mac.', t: 'ClipMac makes no network requests. Its libraries are bundled inside the app.' },
	{ h: 'History is not encrypted.', t: 'It lives in ~/Library/Application Support/com.clipmac.app/. Anything you haven’t favorited is deleted after 24 hours.' },
	{ h: 'Secret detection is best effort.', t: 'OCR can miss small, blurry or stylized text, and the detector knows common formats, not every possible one. It doesn’t cover credit card numbers, emails or phone numbers. Don’t make it your only protection.' },
	{ h: 'Not notarized yet.', t: 'Builds are ad-hoc signed, so the first open shows a Gatekeeper warning. Right-click the app and choose Open, or run the command below. macOS also asks for Screen Recording again after each update.' },
	{ h: 'Not on the Mac App Store.', t: 'The transparent, vibrant window uses a private macOS API, which the App Store doesn’t allow.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>ClipMac, clipboard history and screenshots for macOS</title>
		<meta name="description" content="ClipMac is a free, open-source clipboard manager and screenshot tool for macOS. It remembers what you copy for 24 hours, hides secrets automatically, and keeps everything on your Mac." />
		<meta name="theme-color" content="#5a3cf0" />
		<meta property="og:title" content="ClipMac: your clipboard, with a memory" />
		<meta property="og:description" content="Free, open-source clipboard history and screenshots for macOS. Secrets hidden automatically. Nothing leaves your Mac." />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/png" href="/icon.png" />
		<link rel="apple-touch-icon" href="/icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=JetBrains+Mono:wght@500&family=Onest:wght@400;500;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<div class="hero">
			<header class="bar">
				<a class="brand" href="/" aria-label="ClipMac home">
					<img src="/icon.png" width="38" height="38" alt="" />
					<span>ClipMac</span>
				</a>
				<nav aria-label="Primary">
					<a href="#secrets">Secrets</a>
					<a href="#screenshots">Screenshots</a>
					<a href="#fine-print">Privacy</a>
					<a class="gh" href={REPO}>GitHub</a>
				</nav>
			</header>

			<main id="main">
				<section class="hero-grid" aria-labelledby="h1">
					<div class="hero-copy">
						<h1 id="h1">Your clipboard, with a&nbsp;memory.</h1>
						<p class="lead">
							ClipMac lives in your Mac’s menu bar. It remembers everything you copy for 24 hours, hides your
							secrets automatically, and turns screenshots into something you’re happy to share.
						</p>
						<div class="cta-row">
							<a class="btn btn-lime" href={RELEASES}>
								<svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v10m0 0-4-4m4 4 4-4M4 16.5h12"/></svg>
								Download for Mac
							</a>
							<p class="cta-note">Free and open source · v1.0.1<br /><a href="#fine-print">First launch: right-click → Open</a></p>
						</div>
					</div>

					<div class="desk" aria-label="Interactive demo of the ClipMac menu-bar window">
						<div class="menubar" aria-hidden="true">
							<span class="mb-apple"></span>
							<span class="mb-item mb-on">
								<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="4" width="11" height="13" rx="2.5"/><path d="M7.5 4V3.2c0-.7.5-1.2 1.2-1.2h2.6c.7 0 1.2.5 1.2 1.2V4"/></svg>
							</span>
							<span class="mb-item">Wi-Fi</span>
							<span class="mb-item" id="mb-time">9:41</span>
						</div>

						<div class="pop">
							<div class="try">
								<p class="try-title">Copy something, anything on this page <kbd>⌘</kbd><kbd>C</kbd></p>
								<div class="try-row">
									<span class="try-label">or click to copy:</span>
									<button type="button" class="try-chip" data-copy="Meet at 3pm, room 4B">Meet at 3pm, room 4B</button>
									<button type="button" class="try-chip" data-copy="API_KEY=sk_live_9fA2xK81mQ0zT7vBn4">API_KEY=sk_live_9fA2xK81mQ0zT7vBn4</button>
									<button type="button" class="try-chip" data-copy="postgres://admin:hunter2@db.internal/app">postgres://admin:hunter2@db.internal/app</button>
								</div>
							</div>
							<ul class="clips" id="clips" aria-label="Clipboard history"></ul>
							<p class="pop-foot"><span id="count">5 items</span><span>Illustrative demo · nothing is sent anywhere</span></p>
						</div>
						<div class="toast" id="toast" role="status" aria-live="polite"></div>
					</div>
				</section>
			</main>
		</div>

		<!-- ───── What it keeps ───── -->
		<section class="band band-paper keeps" aria-labelledby="keeps-t">
			<div class="wrap">
				<h2 id="keeps-t">Remembers for a day. Keeps what you star.</h2>
				<div class="track" role="img" aria-label="A 24-hour timeline: clips fade out after 24 hours, favorites are kept">
					<div class="track-bar"><i style="--x:6%"></i><i style="--x:19%"></i><i style="--x:34%"></i><i style="--x:52%"></i><i style="--x:71%"></i></div>
					<div class="track-end"><span class="fav">★</span> Favorites never expire</div>
				</div>
				<div class="cols">
					<p><strong>Text and images.</strong> Everything you copy is saved, grouped into Text and Images. Search it, filter by All, Favorites, Text or Images, and sort by newest, oldest, largest or smallest.</p>
					<p><strong>Gone after 24 hours.</strong> Unless you press <kbd>⌘</kbd><kbd>D</kbd>. Favorites stay until you unfavorite them, and can’t be deleted or cleared by accident.</p>
					<p><strong>Always in the menu bar.</strong> Your latest copies are one click away. Close the window and ClipMac keeps running.</p>
				</div>
			</div>
		</section>

		<!-- ───── Secrets ───── -->
		<section class="band band-violet" id="secrets" aria-labelledby="sec-t">
			<div class="wrap split">
				<div>
					<h2 id="sec-t">Secrets hide themselves.</h2>
					<p class="big">API keys, tokens, passwords, JWTs, private keys and credentials in URLs are spotted in what you copy, and in your screenshots too, using on-device OCR.</p>
					<p>Hidden clips show dots or black bars until you click Show. Drag, export, copy and the menu bar all use the hidden version.</p>
					<p class="honest">Best effort, not a guarantee. It doesn’t cover credit card numbers, emails or phone numbers.</p>
				</div>
				<div class="demo-card">
					<div class="switch-row">
						<span id="sw-label">Auto-hide secrets</span>
						<button class="switch" id="autohide" role="switch" aria-checked="true" aria-labelledby="sw-label"><i></i></button>
					</div>
					<ul class="plain" id="sec-list"></ul>
					<p class="demo-note">Illustrative demo with made-up secrets.</p>
				</div>
			</div>
		</section>

		<!-- ───── Screenshots ───── -->
		<section class="band band-lime" id="screenshots" aria-labelledby="sc-t">
			<div class="wrap split rev">
				<div class="editor" aria-label="Editor preview">
					<div class="stage" id="stage" data-bg="sunset">
						<div class="shot" id="shot">
							<div class="shot-dots" aria-hidden="true"><i></i><i></i><i></i></div>
							<pre class="shot-code" aria-label="Sample code with the token blacked out"><code>const client = connect(&#123;
  host: "db.internal",
  token: <span class="bar">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>,
&#125;);</code></pre>
						</div>
					</div>
					<div class="controls">
						<fieldset>
							<legend>Background</legend>
							<div class="swatches">
								<button type="button" class="sw sw-sunset" data-bg="sunset" aria-pressed="true" aria-label="Sunset gradient"></button>
								<button type="button" class="sw sw-ocean" data-bg="ocean" aria-pressed="false" aria-label="Ocean gradient"></button>
								<button type="button" class="sw sw-mint" data-bg="mint" aria-pressed="false" aria-label="Mint gradient"></button>
								<button type="button" class="sw sw-ink" data-bg="ink" aria-pressed="false" aria-label="Solid ink"></button>
								<button type="button" class="sw sw-clear" data-bg="clear" aria-pressed="false" aria-label="Transparent"></button>
							</div>
						</fieldset>
						<label class="range">Padding <input type="range" id="pad" min="8" max="56" value="32" /></label>
						<label class="range">Corner radius <input type="range" id="rad" min="0" max="28" value="12" /></label>
					</div>
					<p class="demo-note">Illustrative preview of the editor’s controls.</p>
				</div>
				<div>
					<h2 id="sc-t">Screenshots that look finished.</h2>
					<p class="big">Capture a selection, a window or the full screen at full Retina resolution, as a lossless PNG.</p>
					<p>Set a delay, show the cursor, keep the window shadow, and give each mode its own global shortcut. Then dress it up in the built-in editor with a background, padding, corner radius, shadow, zoom and aspect ratio. Save a copy or overwrite.</p>
					<p>Drag the result straight into Finder, Mail, Slack, Figma or a browser, or use Copy as File, or export PNG and JPEG.</p>
				</div>
			</div>
		</section>

		<!-- ───── Code ───── -->
		<section class="band band-ink" aria-labelledby="code-t">
			<div class="wrap split">
				<div>
					<h2 id="code-t">Code gets tidied.</h2>
					<p class="big">Copied code is detected automatically and shown with syntax highlighting and line numbers.</p>
					<p>One Format button tidies JavaScript, TypeScript, JSON, CSS, SCSS, Less, HTML, Markdown, YAML (with Prettier) and Rust (with rustfmt). Copy the formatted version without changing the saved clip.</p>
				</div>
				<div class="demo-card dark">
					<div class="code-head">
						<span>clip.json</span>
						<button class="btn-copy" id="fmt" type="button" aria-pressed="false">Format</button>
					</div>
					<pre class="code" id="code" tabindex="0" aria-live="polite"></pre>
					<p class="demo-note">Illustrative demo.</p>
				</div>
			</div>
		</section>

		<!-- ───── Keys ───── -->
		<section class="band band-paper" aria-labelledby="keys-t">
			<div class="wrap">
				<h2 id="keys-t">Hands stay on the keys.</h2>
				<ul class="keys">
					{keys.map((r) => (
						<li>
							<span class="caps">{r.k.map((c) => <kbd>{c}</kbd>)}</span>
							<span>{r.d}</span>
						</li>
					))}
				</ul>
				<p class="note">Screenshot shortcuts are yours to choose in the camera panel. Avoid <kbd>⌘</kbd><kbd>⇧</kbd><kbd>3</kbd>, <kbd>4</kbd> and <kbd>5</kbd>, which macOS keeps for itself.</p>
			</div>
		</section>

		<!-- ───── Fine print ───── -->
		<section class="band band-lilac" id="fine-print" aria-labelledby="fp-t">
			<div class="wrap">
				<h2 id="fp-t">The honest fine print.</h2>
				<ul class="fine">
					{fine.map((f) => (
						<li><strong>{f.h}</strong><span>{f.t}</span></li>
					))}
				</ul>
				<p class="cmd-label">If macOS blocks the first open:</p>
				<pre class="cmd"><code>xattr -cr /Applications/ClipMac.app</code></pre>
			</div>
		</section>

		<!-- ───── Close ───── -->
		<section class="band band-violet close" aria-labelledby="dl-t">
			<div class="wrap">
				<img class="close-icon" src="/icon.png" width="96" height="96" alt="" />
				<h2 id="dl-t">Copy once. Keep it a day.</h2>
				<p class="big">ClipMac 1.0.1 for macOS, Apple Silicon and Intel. Free and open source under the MIT license.</p>
				<a class="btn btn-lime btn-xl" href={RELEASES}>Download for Mac</a>
			</div>
		</section>

		<footer class="foot">
			<p>© ClipMac contributors · MIT License</p>
			<nav aria-label="Footer">
				<a href={REPO}>Source on GitHub</a>
				<a href={`${REPO}/blob/main/SECURITY.md`}>Security</a>
				<a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contribute</a>
			</nav>
		</footer>

		<script>
			const $ = (id) => document.getElementById(id);
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Illustrative detector: a few common formats, not the app's full rule set.
			const RULES = [
				/\b(?:sk|pk|rk)_(?:live|test)_[A-Za-z0-9_]{8,}/g,
				/\bgh[pousr]_[A-Za-z0-9]{16,}/g,
				/\bAKIA[0-9A-Z]{12,}/g,
				/\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]*/g,
				/(?<=(?:password|passwd|pwd|secret|token|api[_-]?key)\s*[=:]\s*)\S+/gi,
				/(?<=:\/\/[^\s:@\/]+:)[^\s@\/]+(?=@)/g,
			];
			function split(text) {
				const marks = [];
				for (const re of RULES) for (const m of text.matchAll(re)) marks.push([m.index, m.index + m[0].length]);
				marks.sort((a, b) => a[0] - b[0]);
				const merged = [];
				for (const m of marks) {
					const last = merged[merged.length - 1];
					if (last && m[0] <= last[1]) last[1] = Math.max(last[1], m[1]);
					else merged.push(m.slice());
				}
				const parts = [];
				let at = 0;
				for (const [s, e] of merged) {
					if (s > at) parts.push({ t: text.slice(at, s), secret: false });
					parts.push({ t: text.slice(s, e), secret: true });
					at = e;
				}
				if (at < text.length) parts.push({ t: text.slice(at), secret: false });
				return parts;
			}
			const hasSecret = (t) => split(t).some((p) => p.secret);
			function fill(el, text, hide) {
				el.replaceChildren();
				for (const p of split(text)) {
					if (p.secret && hide) el.append(document.createTextNode('••••••••'));
					else el.append(document.createTextNode(p.t));
				}
			}

			const ICONS = {
				text: '<path d="M4 6h12M4 10h12M4 14h8"/>',
				link: '<path d="M8.5 11.5a3 3 0 0 0 4.2 0l2.3-2.3a3 3 0 0 0-4.2-4.2l-.8.8M11.5 8.5a3 3 0 0 0-4.2 0L5 10.8a3 3 0 0 0 4.2 4.2l.8-.8"/>',
				key: '<path d="M10 2.5 16 5v4.5c0 3.6-2.5 6-6 7.5-3.5-1.5-6-3.9-6-7.5V5z"/><path d="m7.3 9.8 2 2 3.6-3.8"/>',
				image: '<rect x="3" y="4" width="14" height="12" rx="2.5"/><circle cx="7.5" cy="8.5" r="1.3"/><path d="m4 14 4-3.5 3 2.5 2.5-2L17 14"/>',
				code: '<path d="m7 6-4 4 4 4M13 6l4 4-4 4"/>',
			};
			const icon = (k) => `<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[k]}</svg>`;
			const kindOf = (t) => (hasSecret(t) ? 'key' : /^https?:\/\/|^[\w-]+\.[a-z]{2,}\/\S+/i.test(t) ? 'link' : /[{};=]|=>/.test(t) ? 'code' : 'text');

			// ───── Hero popover ─────
			let uid = 0;
			const clips = [
				{ id: uid++, kind: 'text', text: 'Standup moved to 3pm, room 4B', age: 2 },
				{ id: uid++, kind: 'link', text: 'github.com/coros-hq/clipmac', age: 14 },
				{ id: uid++, kind: 'key', text: 'STRIPE_KEY=sk_live_51NfK2xQ8mZ0tR7vBn4', age: 38 },
				{ id: uid++, kind: 'image', text: 'Screenshot.png', age: 95 },
				{ id: uid++, kind: 'code', text: 'const total = items.reduce(add, 0);', age: 190 },
			];
			const list = $('clips');
			const shown = new Set();
			const faved = new Set();
			const ageLabel = (m) => (m < 1 ? 'now' : m < 60 ? `${m}m` : `${Math.floor(m / 60)}h`);

			function render(newId) {
				list.replaceChildren();
				for (const c of clips) {
					const secret = c.kind !== 'image' && hasSecret(c.text);
					const li = document.createElement('li');
					li.className = 'clip' + (c.id === newId && !reduce ? ' fresh' : '');
					const copy = document.createElement('button');
					copy.className = 'clip-main';
					copy.type = 'button';
					copy.setAttribute('aria-label', 'Copy again: ' + (secret && !shown.has(c.id) ? 'hidden secret' : c.text));
					const ico = document.createElement('span');
					ico.className = 'ico ico-' + c.kind;
					ico.innerHTML = icon(c.kind);
					const body = document.createElement('span');
					body.className = 'clip-text';
					if (c.kind === 'image') {
						const th = document.createElement('i');
						th.className = 'thumb';
						body.append(th, document.createTextNode(c.text));
					} else {
						fill(body, c.text, secret && !shown.has(c.id));
						if (c.kind === 'code') body.classList.add('mono');
					}
					const meta = document.createElement('span');
					meta.className = 'clip-meta';
					meta.textContent = faved.has(c.id) ? 'kept' : ageLabel(c.age);
					copy.append(ico, body, meta);
					copy.addEventListener('click', () => toast(secret && !shown.has(c.id) ? 'Copied (hidden version)' : 'Copied'));
					li.append(copy);
					if (secret) {
						const s = document.createElement('button');
						s.type = 'button';
						s.className = 'mini';
						s.textContent = shown.has(c.id) ? 'Hide' : 'Show';
						s.addEventListener('click', () => { shown.has(c.id) ? shown.delete(c.id) : shown.add(c.id); render(); });
						li.append(s);
					}
					const f = document.createElement('button');
					f.type = 'button';
					f.className = 'star' + (faved.has(c.id) ? ' on' : '');
					f.setAttribute('aria-pressed', String(faved.has(c.id)));
					f.setAttribute('aria-label', 'Favorite');
					f.textContent = '★';
					f.addEventListener('click', () => { faved.has(c.id) ? faved.delete(c.id) : faved.add(c.id); render(); });
					li.append(f);
					list.append(li);
				}
				$('count').textContent = `${clips.length} items`;
			}
			let toastT;
			function toast(msg) {
				const t = $('toast');
				t.textContent = msg;
				t.classList.add('on');
				clearTimeout(toastT);
				toastT = setTimeout(() => t.classList.remove('on'), 1400);
			}
			function addClip(raw) {
				const text = raw.trim().replace(/\s+/g, ' ').slice(0, 140);
				if (!text || (clips[0] && clips[0].text === text)) return;
				const id = uid++;
				clips.unshift({ id, kind: kindOf(text), text, age: 0 });
				if (clips.length > 7) clips.pop();
				render(id);
				toast(hasSecret(text) ? 'Copied, secret hidden' : 'Copied and saved');
			}
			// A real copy anywhere on the page lands in the history, like the app does.
			document.addEventListener('copy', () => addClip(String(getSelection() || '')));
			document.querySelectorAll('.try-chip').forEach((b) =>
				b.addEventListener('click', () => {
					const sel = getSelection();
					const r = document.createRange();
					r.selectNodeContents(b);
					sel.removeAllRanges();
					sel.addRange(r);
					// execCommand fires the copy event above; fall back to adding directly.
					let ok = false;
					try { ok = document.execCommand('copy'); } catch (e) {}
					if (!ok) addClip(b.dataset.copy);
					else if (clips[0].text !== b.dataset.copy.trim()) addClip(b.dataset.copy);
				})
			);
			render();
			$('mb-time').textContent = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });

			// ───── Secrets demo ─────
			const secrets = ['DATABASE_URL=postgres://admin:hunter2@db.internal/app', 'Lunch at noon?', 'Authorization: token ghp_Q8mZ4tVn2LxK7wB1cD9eF3gH5j'];
			const sw = $('autohide');
			function paintSecrets() {
				const on = sw.getAttribute('aria-checked') === 'true';
				const ul = $('sec-list');
				ul.replaceChildren();
				for (const t of secrets) {
					const li = document.createElement('li');
					const k = kindOf(t);
					const i = document.createElement('span');
					i.className = 'ico ico-' + k;
					i.innerHTML = icon(k);
					const s = document.createElement('span');
					s.className = 'clip-text';
					fill(s, t, on);
					li.append(i, s);
					ul.append(li);
				}
			}
			sw.addEventListener('click', () => { sw.setAttribute('aria-checked', String(sw.getAttribute('aria-checked') !== 'true')); paintSecrets(); });
			paintSecrets();

			// ───── Editor preview ─────
			const stage = $('stage');
			const shot = $('shot');
			document.querySelectorAll('.sw').forEach((b) =>
				b.addEventListener('click', () => {
					stage.dataset.bg = b.dataset.bg;
					document.querySelectorAll('.sw').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
				})
			);
			$('pad').addEventListener('input', (e) => stage.style.setProperty('--pad', e.target.value + 'px'));
			$('rad').addEventListener('input', (e) => shot.style.setProperty('--rad', e.target.value + 'px'));

			// ───── Format demo ─────
			const raw = '{"name":"clipmac","version":"1.0.1","local":true,"tags":["clipboard","screenshots"]}';
			const pretty = JSON.stringify(JSON.parse(raw), null, 2);
